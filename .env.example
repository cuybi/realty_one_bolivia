# ==============================================================================
# REALTY ONE GROUP BOLIVIA - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y rellena con tus credenciales reales.
# ==============================================================================

# Entorno y Servidor
NODE_ENV=production
PORT=3000
TZ=America/La_Paz

# Credenciales de Acceso Seguro al Panel CRM y Conector QR
ADMIN_USER=admin
ADMIN_PASS=ONE2026
ADMIN_KEY=ONE2026
QR_USER=admin
QR_PASS=ONE2026

# Base de Datos MongoDB Atlas (Persistencia de Sesión WhatsApp 24/7)
# Obtén tu cluster M0 gratuito en: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/realty_one_bot?appName=Cluster0

# Meta WhatsApp Cloud API (Opcional si usas Baileys QR Web)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=realty_one_whatsapp_verify_token_2026

# Google Gemini AI (Opcional para respuestas inteligentes avanzadas)
GEMINI_API_KEY=
